# 把這個檔案複製一份改名為 .env，然後填入下面的值
# .env 內容不會被分享（被 .gitignore 擋住），請勿把 .env 上傳到 GitHub 等公開地方

# ==========================================
# Gmail 寄信設定
# ==========================================
# 你的 Gmail 信箱
GMAIL_USER=yourname@gmail.com

# Gmail App Password（16 碼，含空格）
# 申請：https://myaccount.google.com/apppasswords
# 須先開啟 Google 帳號的兩步驟驗證
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 收件人 email（留空則寄給自己）
MAIL_TO=

# ==========================================
# LINE 官方帳號推播設定（週報用）
# ==========================================
# Channel Access Token（長效版）
# 取得方式：
#  1. 到 https://developers.line.biz/console/ 用 LINE 帳號登入
#  2. 建立 Provider（如果第一次用）
#  3. 在 Provider 下建立 'Messaging API channel'
#  4. 把你的官方帳號連結到這個 channel
#  5. 進入 channel → 'Messaging API' 分頁
#  6. 拉到 'Channel access token' 區 → 點 'Issue' 產生長效 token
#  7. 把 token 整段貼到下面
LINE_CHANNEL_ACCESS_TOKEN=

# ==========================================
# Apify FB 爬蟲設定（可選；沒設就跳過 FB）
# ==========================================
# 從 https://console.apify.com/settings/integrations 取得 Personal API token
# 格式：apify_api_xxxxxxxxxxxxxxxxxx
APIFY_API_TOKEN=

# ==========================================
# 中央氣象署 OpenData（雨量監控用）
# ==========================================
# 註冊：https://opendata.cwa.gov.tw/userregister
# 登入後 → 會員資訊 → API 授權碼
# 格式：CWA-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
CWA_API_KEY=

# ==========================================
# catbox.moe 永久上傳設定（可選；沒設就匿名上傳）
# ==========================================
# 註冊 catbox 帳號後可拿到 64 字元的 userhash
# 取得方式：
#  1. 到 https://catbox.moe/user/register.php 註冊（只要 email + 密碼）
#  2. 登入後到 https://catbox.moe/user/manage.php 看 "Your userhash" 那一行
#  3. 整段 64 字元複製貼到下面
# 帶 userhash 的好處：
#   - 上傳檔案可在 catbox 後台管理（編輯/刪除/重新命名）
#   - 比較不會被 anti-abuse 攔截（cloud IP 匿名常被 412）
CATBOX_USERHASH=
