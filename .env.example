# 把這個檔案複製一份改名為 .env，然後填入下面的值
# .env 內容不會被分享（被 .gitignore 擋住），請勿把 .env 上傳到 GitHub 等公開地方

# ==========================================
# Gmail 寄信設定
# ==========================================
# 你的 Gmail 信箱
GMAIL_USER=yourname@gmail.com

# Gmail App Password（16 碼，含空格）
# 申請：https://myaccount.google.com/apppasswords
# 須先開啟 Google 帳號的兩步驟驗證
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 收件人 email（留空則寄給自己）
MAIL_TO=

# ==========================================
# LINE 官方帳號推播設定（週報用）
# ==========================================
# Channel Access Token（長效版）
# 取得方式：
#  1. 到 https://developers.line.biz/console/ 用 LINE 帳號登入
#  2. 建立 Provider（如果第一次用）
#  3. 在 Provider 下建立 'Messaging API channel'
#  4. 把你的官方帳號連結到這個 channel
#  5. 進入 channel → 'Messaging API' 分頁
#  6. 拉到 'Channel access token' 區 → 點 'Issue' 產生長效 token
#  7. 把 token 整段貼到下面
LINE_CHANNEL_ACCESS_TOKEN=

# ==========================================
# Apify FB 爬蟲設定（可選；沒設就跳過 FB）
# ==========================================
# 從 https://console.apify.com/settings/integrations 取得 Personal API token
# 格式：apify_api_xxxxxxxxxxxxxxxxxx
APIFY_API_TOKEN=
